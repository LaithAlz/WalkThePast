# Browser-safe Clerk publishable key only. Never put CLERK_SECRET_KEY in a Vite app.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# OpenAI writes the world guide and paints the photograph for text-only worlds (gpt-image-1)
OPENAI_API_KEY=
# OPENAI_TEXT_MODEL=gpt-5.4-mini
# Optional: Gemini as an alternative image model for the older "imagine the other angles" API
GEMINI_API_KEY=

# Marble (World Labs) generates the worlds. Server-side only, never a VITE_* name.
# https://platform.worldlabs.ai/api-keys
WORLDLAB_API_KEY=

# Where the backend lives. Leave EMPTY for local dev: the Vite dev server supplies
# /api and public/worlds/ itself. Set it on Vercel to the deployed Worker's origin,
# e.g. https://walk-the-past.marwan13223.workers.dev
VITE_API_BASE=
